# Heardit configuration
# This file is gitignored. Never commit a real .env.

# ── Required ──────────────────────────────────────
# Summaries, keyword explanations, AI chat
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Model for study notes (chat and keywords stay on gpt-4o-mini)
# SUMMARY_MODEL=gpt-4o

# ── Transcription (recommended) ───────────────────
# Speaker separation for meetings, less than half the price of whisper
# https://www.assemblyai.com/app/account
ASSEMBLYAI_API_KEY=your-key-here

# ── Transcription (optional) ──────────────────────
# Cheapest engine for lectures. Falls back to the ones above when unset.
# https://console.groq.com/keys
# GROQ_API_KEY=

# ── Sign-in ───────────────────────────────────────
# console.cloud.google.com -> Credentials -> OAuth client ID (Web application)
# Authorized redirect URI: http://127.0.0.1:5001/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the session cookie. Without it everyone is logged out on every restart.
# Generate: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# Temporary local sign-in until Google is configured (ignored in production)
# ALLOW_DEV_LOGIN=1

# ── Money locks (mandatory for deployment) ────────
# Invite-only sign-in while testing: only these Google accounts can log in.
# Leave EMPTY to open the service to the public — the free tier (2 h/month)
# and MONTHLY_BUDGET_MINUTES below then cap what strangers can cost you.
ALLOWED_EMAILS=
# ALLOWED_DOMAINS=columbia.edu

# Accounts that always have Pro, no payment or code needed (the owner).
OWNER_EMAILS=you@example.com

# Promo codes created at startup if missing (no shell needed on the host).
#   CODE:percent:20:200   20% off, 200 uses
#   CODE:fixed:3000:50    3,000 KRW off, 50 uses
#   CODE:comp:pro:12:5    free Pro for 12 months, 5 uses (reviewers, friends)
# PROMO_SEED=WELCOME20:percent:20:200,FRIENDS:comp:student:3:10

# Total minutes the whole service may transcribe per month, all users combined.
# 600 min ≈ 10 h ≈ about $2.5 on AssemblyAI, about $3.6 on whisper.
MONTHLY_BUDGET_MINUTES=600

# ── Payments (optional until launch) ──────────────
# Stripe Checkout handles plans (monthly) and credit packs (one-time).
# Without these, a local dev build simulates purchases and production shows
# "payments not open yet". Webhook endpoint: /api/billing/webhook
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── YouTube from a hosted server (optional) ───────
# YouTube returns 403 to most datacenter IPs. A residential/rotating proxy
# (e.g. Webshare) or a cookies.txt from a signed-in browser gets past it.
# YTDLP_PROXY=http://user:pass@proxy.example:port
# YTDLP_COOKIES=/var/data/youtube-cookies.txt
